{
  "name": "cucu-frontend-e2e-tests",
  "version": "1.0.0",
  "description": "E2E and integration tests for Cucu Frontend",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run && playwright test",
    "test:e2e:local": "TEST_ENV=local playwright test",
    "test:e2e:staging": "TEST_ENV=staging playwright test",
    "test:e2e:prod": "TEST_ENV=production playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.4"
  }
}
